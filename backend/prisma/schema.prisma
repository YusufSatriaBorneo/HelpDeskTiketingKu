generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  HELPDESK
  ENGINEER
}

enum Status {
  OPEN
  ASSIGNED
  IN_PROGRESS
  HOLD
  RESOLVED
}

model User {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  password        String
  name            String
  role            Role            @default(USER)
  createdTickets  Ticket[]        @relation("CreatedTickets")
  assignedTickets Ticket[]        @relation("AssignedTickets")
  ticketHistories TicketHistory[] @relation("UserTicketHistories") // <-- TAMBAHAN BARU
  createdAt       DateTime        @default(now())
}

model Ticket {
  id               Int           @id @default(autoincrement())
  ticketNumber     String        @unique 
  title            String
  description      String
  phoneDir         String?
  hostname         String?
  category         String?
  subCategory      String?
  attachmentUrl    String?
  priority         String?       @default("Standard")
  notes            String?

  status           Status        @default(OPEN)
  
  // --- TAMBAHAN KOLOM SLA & PAUSE ---
  slaMinutes       Int           @default(120)
  slaTarget      DateTime?
  pausedAt         DateTime?     
  totalPausedMin   Int           @default(0)  
  isSlaBreached    Boolean       @default(false) 
  // ---------------------------------
// <-- 2. TAMBAHKAN 2 KOLOM INI -->
  workStartedAt  DateTime? // Kapan tiket pertama kali di "In Progress"
  resolvedAt     DateTime? // Kapan tiket berstatus "Resolved"
  actualWorkMin Int?
  // ---------------------------------

  createdById      Int
  createdBy        User          @relation("CreatedTickets", fields: [createdById], references: [id])
  
  assignedToId     Int?
  assignedTo       User?         @relation("AssignedTickets", fields: [assignedToId], references: [id])
  
  histories        TicketHistory[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ==========================================
// TAMBAHAN MODEL BARU UNTUK HISTORY
// ==========================================
model TicketHistory {
  id          Int      @id @default(autoincrement())
  
  ticketId    Int
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  status      Status   // Menyimpan status saat update dilakukan
  note        String?  // Menyimpan catatan saat tiket dilempar/diupdate
  
  updatedById Int
  updatedBy   User     @relation("UserTicketHistories", fields: [updatedById], references: [id]) // Mencatat siapa engineer/helpdesk-nya
  
  createdAt   DateTime @default(now()) // Otomatis mencatat Date dan Time
}